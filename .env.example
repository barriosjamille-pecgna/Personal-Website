# Copy this file to .env for local development, and set the same
# two variables in Netlify's Site settings -> Environment variables
# for production. Only the ANON key ever goes here — never the
# service role key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
